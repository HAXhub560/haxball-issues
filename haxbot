const room = HBInit({
  roomName: "5v5 Bot Maçı",
  maxPlayers: 16,
  public: false,
  noPlayer: true // Headless mod
});

room.setDefaultStadium("Big");
room.setScoreLimit(3);
room.setTimeLimit(3);

// Botlar
const NUM_PLAYERS_PER_TEAM = 5; // 1 kaleci + 4 oyuncu
const bots = [];

function createBot(name, team, isGoalkeeper = false) {
  const bot = {
    id: bots.length + 1,
    name,
    team,
    isGoalkeeper,
    x: 0,
    y: 0,
  };
  bots.push(bot);
  room.setPlayerAdmin(bot.id, true);
}

// Oyuna bot ekle
for (let i = 0; i < NUM_PLAYERS_PER_TEAM; i++) {
  createBot("Blue_" + (i === 0 ? "GK" : "Bot" + i), 1, i === 0);
  createBot("Red_" + (i === 0 ? "GK" : "Bot" + i), 2, i === 0);
}

// Bot AI
room.onGameTick = function () {
  const ball = room.getBallPosition();

  bots.forEach(bot => {
    const pos = room.getPlayer(bot.id)?.position;
    if (!pos) return;

    let dx = ball.x - pos.x;
    let dy = ball.y - pos.y;

    const distance = Math.sqrt(dx * dx + dy * dy);

    // Kaleci davranışı
    if (bot.isGoalkeeper) {
      if (bot.team === 1) dx = ball.x + 350 - pos.x;
      else dx = ball.x - 350 - pos.x;
      dy = ball.y - pos.y;
    }

    // Normalize hareket
    const speed = bot.isGoalkeeper ? 0.2 : 0.4;
    const norm = Math.max(1, distance);
    room.setKeyState(bot.id, {
      x: dx / norm * speed,
      y: dy / norm * speed,
    });
  });
};
